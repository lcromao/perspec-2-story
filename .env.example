# =============================================================================
# LLM-as-a-judge settings.
# .env holds your API key: do not share it or commit it (it is in .gitignore).
# .env.example is the same file without the key, kept as a template.
#
# Precedence: variables exported in the shell > this file > config.json.
# An empty value means "use the default" (shown in the comment above it).
# Check the effective settings with:  sh run.sh config
#
# Not configurable here on purpose: the pairs and the private X/Y key
# (config.json > "pairs"), because they define the study design and must not
# change between runs.
# =============================================================================


# --- OpenRouter ---------------------------------------------------------------
# Key used only for this study, with a credit limit:
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Shown in the OpenRouter activity log (app name and optional URL).
OPENROUTER_APP_TITLE="CAIN 2027 - Data and Model Stories expert evaluation"
OPENROUTER_APP_URL=
# Chat completions endpoint. Default: https://openrouter.ai/api/v1/chat/completions
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions


# --- Files ----------------------------------------------------------------------
# Paths are relative to this folder. {pair} is replaced by M1, M2, N1 or N2.
PROMPT_SYSTEM=prompts/01_System_Prompt_EN.md
PROMPT_SHARED_CONTEXT=prompts/02_Project_Context_EN.md
PROMPT_EXECUTION=prompts/03_Execution_Prompt_EN.md
PAIR_CONTEXT_PATTERN=contexts/02_Context_{pair}_EN.md
RUNS_DIR=runs
# Python interpreter used by run.sh. Default: python3
PY=python3


# --- Study run ("sh run.sh full") -------------------------------------------------
# Folder under RUNS_DIR. Default: main
RUN_NAME=main
# Pairs to run, comma-separated (M1,M2,N1,N2). Empty = all.
PAIRS=
# original, swapped (position-bias control). Keep both for the study.
ORDERS=original,swapped
# Repetitions per judge x pair x order.
REPS=3
# Parallel requests.
WORKERS=4
# Re-runs when the output is not valid JSON or fails validation.
MAX_INVALID_RETRIES=2
# Seconds to wait for one response (slow free models need more).
TIMEOUT_S=1800
# Retries on HTTP errors (408, 429, 5xx), with exponential backoff.
HTTP_RETRIES=5


# --- Provider policy (sent with every request) ------------------------------------
# deny: only providers that do not store or train on prompts (the stories were
# written by participants). allow: any provider your account settings permit.
PROVIDER_DATA_COLLECTION=deny
# true: only providers that support every parameter sent (JSON schema, reasoning);
# a provider that would silently ignore the schema is skipped instead.
PROVIDER_REQUIRE_PARAMETERS=true


# --- Defaults for every judge -----------------------------------------------------
# Reasoning effort sent as reasoning.effort (for example low, medium, high).
REASONING_EFFORT=high
# Output token budget, reasoning included (every judge accepts up to 128000).
MAX_TOKENS=64000


# --- Judges -----------------------------------------------------------------------
# For each judge:
#   ID                 name used in folders and results (change only before the first run)
#   ENABLED            false leaves the judge out of "run" and "status"
#   MODEL              slug copied from the model page on openrouter.ai
#   WEIGHTS            open or closed (only labels the results)
#   PROVIDER           provider slug(s) from the model's Providers tab, comma-separated;
#                      empty = automatic routing. Pinning is recommended for open-weight models.
#   ALLOW_FALLBACKS    with a pinned PROVIDER: true lets OpenRouter use other providers
#   STRUCTURED_OUTPUT  false if the model rejects the JSON schema (response_format)
#   REASONING_EFFORT   empty = REASONING_EFFORT above
#   MAX_TOKENS         empty = MAX_TOKENS above

JUDGE_SONNET_ID=sonnet-5.5
JUDGE_SONNET_ENABLED=true
JUDGE_SONNET_MODEL=anthropic/claude-sonnet-5.5
JUDGE_SONNET_WEIGHTS=closed
JUDGE_SONNET_PROVIDER=
JUDGE_SONNET_ALLOW_FALLBACKS=false
# Anthropic rejects the 28-key strict schema ("compiled grammar is too large"), so Sonnet
# gets the same JSON format through the prompt only; the runner still validates it.
JUDGE_SONNET_STRUCTURED_OUTPUT=false
JUDGE_SONNET_REASONING_EFFORT=
JUDGE_SONNET_MAX_TOKENS=

JUDGE_SOL_ID=gpt-6.1-sol
JUDGE_SOL_ENABLED=true
JUDGE_SOL_MODEL=openai/gpt-6.1-sol
JUDGE_SOL_WEIGHTS=closed
JUDGE_SOL_PROVIDER=
JUDGE_SOL_ALLOW_FALLBACKS=false
JUDGE_SOL_STRUCTURED_OUTPUT=true
JUDGE_SOL_REASONING_EFFORT=
JUDGE_SOL_MAX_TOKENS=

# Qwen3.8 Max (0902) is API-only. For a second open-weight judge, replace MODEL with
# the open-weight Qwen3.8 variant, set WEIGHTS=open, pin its PROVIDER and update ID.
JUDGE_QWEN_ID=qwen3.8-max
JUDGE_QWEN_ENABLED=true
JUDGE_QWEN_MODEL=qwen/qwen3.8-max-0902
JUDGE_QWEN_WEIGHTS=closed
JUDGE_QWEN_PROVIDER=
JUDGE_QWEN_ALLOW_FALLBACKS=false
JUDGE_QWEN_STRUCTURED_OUTPUT=true
JUDGE_QWEN_REASONING_EFFORT=
JUDGE_QWEN_MAX_TOKENS=

# Pinned to Together: full precision, JSON schema and reasoning supported. DeepSeek's
# own endpoint does not support the JSON schema and may train on prompts.
JUDGE_DEEPSEEK_ID=deepseek-v4.1-flash
JUDGE_DEEPSEEK_ENABLED=true
JUDGE_DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash-1017
JUDGE_DEEPSEEK_WEIGHTS=open
JUDGE_DEEPSEEK_PROVIDER=together
JUDGE_DEEPSEEK_ALLOW_FALLBACKS=false
JUDGE_DEEPSEEK_STRUCTURED_OUTPUT=true
JUDGE_DEEPSEEK_REASONING_EFFORT=
JUDGE_DEEPSEEK_MAX_TOKENS=


# --- Pilot ("sh run.sh pilot") ------------------------------------------------------
# One quick real call before the study. PILOT_JUDGE is a judge ID: the test judge
# below, or a study judge (for example deepseek-v4.1-flash) to check its JSON output.
PILOT_JUDGE=nemotron-test
PILOT_RUN_NAME=pilot
PILOT_PAIRS=M1
PILOT_ORDERS=original
PILOT_REPS=1

# Test judge: stays out of the study (ENABLED=false keeps it out of "run" and "status").
# Free endpoints have daily call limits and may log or train on prompts; if OpenRouter
# answers "no endpoints found matching your data policy", allow free endpoints at
# https://openrouter.ai/settings/privacy
JUDGE_TEST_ID=nemotron-test
JUDGE_TEST_ENABLED=false
JUDGE_TEST_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
JUDGE_TEST_WEIGHTS=open
JUDGE_TEST_PROVIDER=
JUDGE_TEST_ALLOW_FALLBACKS=false
JUDGE_TEST_STRUCTURED_OUTPUT=true
JUDGE_TEST_REASONING_EFFORT=
JUDGE_TEST_MAX_TOKENS=


# --- Smoke test ("sh run.sh smoke", fake judge, no API calls) --------------------------
SMOKE_RUN_NAME=smoke


# --- Human responses (forms A-D) ----------------------------------------------------
# Response sheets downloaded as CSV (File > Download > CSV). Missing files are
# skipped by "analyze".
HUMAN_FORM_A=human/form_A.csv
HUMAN_FORM_B=human/form_B.csv
HUMAN_FORM_C=human/form_C.csv
HUMAN_FORM_D=human/form_D.csv
